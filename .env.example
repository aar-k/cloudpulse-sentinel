# Copy this file to ".env" (same folder) and change the values.
# Use ONLY letters and numbers in DB_PASSWORD (symbols break the database URL).
DB_PASSWORD=ChangeMe12345
COMPOSE_PROFILES=localdb

# Login system. For AWS generate real values:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=local-dev-jwt-secret-change-me-on-aws
INTERNAL_KEY=local-dev-internal-key-change-me-on-aws
# Password for the 4 demo users (admin@/analyst@/developer@/viewer@cloudpulse.local). Min 8 characters.
SEED_PASSWORD=Demo12345

# --- on AWS: delete the COMPOSE_PROFILES line (or set it to https) and set these ---
# DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
# DB_USER=cpadmin
# DB_NAME=cloudpulse
# S3_BUCKET=your-bucket-name
# AWS_DEFAULT_REGION=ap-south-1
# SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/cloudpulse-incidents
# SNS_TOPIC_ARN=                       (only if you skip SQS/Lambda and email directly)
# DASHBOARD_URL=https://1-2-3-4.sslip.io
# COMPOSE_PROFILES=https
# DOMAIN=1-2-3-4.sslip.io
